# JSONL column union, missing values, cross-format join, and glob discovery.
--source mysql_test/test_suite/file_sql/include/copy_file_sql_data.inc
--disable_query_log
let $FILE_SQL_DATA_DIR = $OBSERVER_DIR/data_for_mysqltest_file_sql;
set session enable_file_sql = ON;

eval select id, name, score, active, day, note
       from read_json('$FILE_SQL_DATA_DIR/basic.jsonl', format = 'newline_delimited')
      order by id;
eval select count(*) as row_count, sum(id) as id_sum
       from read_ndjson('$FILE_SQL_DATA_DIR/basic.jsonl');
eval select c.id, j.name
       from read_csv('$FILE_SQL_DATA_DIR/basic.csv') c
       join read_json('$FILE_SQL_DATA_DIR/basic.jsonl') j on c.id = j.id
      order by c.id;
eval select count(*) as row_count, min(c1) as first_value,
            max(c1) as last_value, sum(c1) as value_sum
       from read_parquet('$FILE_SQL_DATA_DIR/simple.parquet');
eval select p.c1, c.name
       from read_parquet('$FILE_SQL_DATA_DIR/simple.parquet') p
       left join read_csv('$FILE_SQL_DATA_DIR/basic.csv') c on p.c1 = c.id
      order by p.c1;
eval select substring_index(file, '/', -1) as file
       from glob('$FILE_SQL_DATA_DIR/*')
      order by file;

set session enable_file_sql = OFF;
--source mysql_test/test_suite/file_sql/include/remove_file_sql_data.inc
